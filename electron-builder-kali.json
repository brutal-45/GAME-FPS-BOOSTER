{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.brutal-tools.brutal-fps",
  "productName": "BRUTAL-FPS",
  "copyright": "Copyright © 2024 Brutal Tools",
  "version": "1.0.1",

  "directories": {
    "output": "release-kali",
    "buildResources": "build"
  },

  "files": [
    "electron/**/*",
    "public/**/*",
    "package.json",
    "!node_modules/**/*"
  ],

  "extraResources": [
    {
      "from": "build",
      "to": "assets",
      "filter": ["icon.*"]
    },
    {
      "from": "public/brutal-fps-standalone.html",
      "to": "app/index.html"
    }
  ],

  "npmRebuild": false,
  "buildDependenciesFromSource": false,

  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb", "arch": ["x64"] }
    ],
    "executableName": "brutal-fps-kali",
    "icon": "build/icon.png",
    "category": "Game",
    "artifactName": "${productName}-${version}-kali.${ext}",
    "desktop": {
      "Name": "BRUTAL-FPS",
      "Comment": "Ultimate Gaming Performance Booster (Kali Linux)",
      "Categories": "Game;Entertainment;",
      "StartupWMClass": "brutal-fps-kali"
    },
    "deb": {
      "packageName": "brutal-fps-kali",
      "synopsis": "BRUTAL-FPS gaming performance booster (Kali Linux build)",
      "description": "BRUTAL-FPS — the ultimate gaming performance booster. Kali-focused build with dependencies for Kali Linux (Debian trixie t64 package names) and older Debian-based distros.",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libasound2t64 | libasound2",
        "libnss3",
        "libxss1 | libxss1t64",
        "libnotify4 | libnotify4t64",
        "fuse3 | fuse"
      ],
      "recommends": ["gpu-driver", "mesa-utils"]
    },
    "appImage": {
      "artifactName": "${productName}-${version}-kali.${ext}"
    }
  },

  "publish": null
}
